###############################################
# Cuentas por Cobrar y Pagar — producción (Coolify)
# Copia estos valores en las "Environment Variables"
# de la Application en Coolify. NO subas el .env real.
###############################################

APP_NAME="Cuentas por Cobrar y Pagar"
APP_ENV=production
APP_KEY=base64:GENERA_CON_php_artisan_key:generate_--show
APP_DEBUG=false
APP_URL=https://cuentascyp.tu-dominio.com
# No definas ASSET_URL en producción: Coolify/Traefik termina el TLS y
# bootstrap/app.php confía en X-Forwarded-Proto, así que los assets de Vite
# usan https automáticamente. (En WAMP local sí se necesita con subruta.)

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

# En producción envía los logs a la salida estándar del contenedor.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

###############################################
# Base de datos (servicio MySQL de Coolify)
# Usa las credenciales internas del servicio MySQL.
###############################################
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cuentascyp
DB_USERNAME=cuentascyp
DB_PASSWORD=cambia_esta_password

###############################################
# Sesión / caché / colas
###############################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Con HTTPS (dominio de Coolify) déjalo en true.
# Si publicas por IP en http, cámbialo a false o el login fallará.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

###############################################
# Usuarios iniciales (php artisan db:seed)
# Cambia las contraseñas después del primer acceso.
###############################################
SEED_ADMIN_EMAIL=admin@cuentascyp.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_CONSULTA_EMAIL=consulta@cuentascyp.test
SEED_CONSULTA_PASSWORD=Consulta123!

# Valores por defecto de negocio (config/cuentas.php).
CUENTAS_TASA_INTERES_DEFAULT=8
CUENTAS_TASA_MORA_DEFAULT=5
CUENTAS_DIAS_MORA_BASE=30
CUENTAS_UNIDAD_MATERIAL_DEFAULT=unidad

###############################################
# Recursos en la imagen (no hace falta tocarlos)
###############################################
AUTORUN_ENABLED=false
PHP_OPCACHE_ENABLE=1
